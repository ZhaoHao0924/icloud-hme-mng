# Required. Generate at least 32 random characters and keep this value out of version control.
ICLOUD_HME_API_TOKEN=

# Bind to 127.0.0.1 by default. Set 0.0.0.0 only when a firewall or reverse proxy protects access.
ICLOUD_HME_BIND_ADDRESS=127.0.0.1
ICLOUD_HME_PORT=8081

# Keep data and backups outside the repository in production.
ICLOUD_HME_DATA_DIR=./data
ICLOUD_HME_IMAGE=icloud-hme:local
ICLOUD_HME_VERSION=dev
TZ=Asia/Shanghai
